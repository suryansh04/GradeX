# Copy to backend/.env and fill in. Never commit the real .env file.

# Local Postgres: postgresql+psycopg://USER:PASSWORD@localhost:5432/DATABASE
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/gradex

# Signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

ANTHROPIC_API_KEY=

# Optional: browser origins allowed to call the API (JSON list).
# CORS_ORIGINS=["http://127.0.0.1:5501","http://localhost:5501"]
